-- Función para actualizar SPLOT
local function UpdateSplot()
    local success, plotNumber = pcall(function()
        local plots = workspace:WaitForChild("Plots")
        for i, plot in ipairs(plots:GetChildren()) do
            if plot:FindFirstChild("Owner") and plot.Owner.Value == player.Name then
                return i
            end
        end
        return 0
    end
    if success then
        SplotNumber.Text = tostring(plotNumber or 0)
    else
        SplotNumber.Text = "0"
    end
end

-- Actualizar SPLOT cada 5 segundos
UpdateSplot()
task.spawn(function()
    while task.wait(5) do
        UpdateSplot()
    end
end)

-- También actualizar cuando el jugador se mueve o cambia de plot
player.CharacterAdded:Connect(function()
    task.wait(1)
    UpdateSplot()
end)

